# =============================================================================
# fastik-landing — environment variables
# Copy to `.env.local` (git-ignored) for local dev. Set the real values in
# Vercel → Project → Settings → Environment Variables.
# =============================================================================

# Public origin of this site. Used for canonical URLs and for the logo/CTA
# links inside the waitlist welcome email.
NEXT_PUBLIC_SITE_URL="https://fastik.io"

# Leave UNSET. lib/api.ts falls back to a relative path when this is empty,
# which is what sends the waitlist form to this site's own /api/subscribers
# route. Only set it if the endpoint ever moves to a separate backend.
# NEXT_PUBLIC_API_URL=""

# --- Waitlist (src/app/api/subscribers/route.ts) -----------------------------
# Resend holds the contact list and sends the welcome email, so the site needs
# no database. Create a key at https://resend.com/api-keys with "Sending
# access" plus Contacts write. Server-only — never prefix with NEXT_PUBLIC.
RESEND_API_KEY=""

# The Audience the signups are added to: Resend → Audiences → (your audience),
# the UUID in the URL.
RESEND_AUDIENCE_ID=""

# The From address on the welcome email. Its domain must be verified in
# Resend → Domains, which means adding their DKIM/SPF records at Namecheap.
WAITLIST_FROM_EMAIL="Fastik <hello@fastik.io>"
