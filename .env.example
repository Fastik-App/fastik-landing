# =============================================================================
# fastik-landing — environment variables
# Copy to `.env.local` (git-ignored) for local dev. Set the real values in
# Vercel → Project → Settings → Environment Variables.
# =============================================================================

# Public origin of this site. Used for canonical URLs and for the logo/CTA
# links inside the waitlist welcome email.
NEXT_PUBLIC_SITE_URL="https://fastik.io"

# Leave UNSET. lib/api.ts falls back to a relative path when this is empty,
# which is what sends the waitlist form to this site's own /api/subscribers
# route. Only set it if the endpoint ever moves to a separate backend.
# NEXT_PUBLIC_API_URL=""

# --- Waitlist (src/app/api/subscribers/route.ts) -----------------------------
# Resend holds the contact list and sends the welcome email, so the site needs
# no database. Create a key at https://resend.com/api-keys with "Sending
# access" plus Contacts write. Server-only — never prefix with NEXT_PUBLIC.
RESEND_API_KEY=""

# Resend replaced Audiences with Segments + Topics, so there are two ids.
# The segment groups signups so a launch broadcast can target them.
RESEND_SEGMENT_ID=""
# The topic carries the subscription preference and drives the unsubscribe
# link in the welcome email.
RESEND_TOPIC_ID=""

# The From address on the welcome email. Deliberately a SUBDOMAIN: bulk mail
# that collects spam complaints damages the sending domain's reputation, and
# keeping that off the apex protects any real correspondence from @fastik.io
# later. Verify send.fastik.io in Resend → Domains and add its DKIM/SPF
# records at Namecheap (on the subdomain, not the apex).
WAITLIST_FROM_EMAIL="Fastik <hello@send.fastik.io>"

# Where replies go. You cannot SEND from a @gmail.com address through Resend
# (you don't own gmail.com, so it can't be verified), but replies can land in
# any inbox. Set this to your Gmail. Kept out of source because this repo is
# public and a personal address in a public repo gets scraped.
WAITLIST_REPLY_TO=""
